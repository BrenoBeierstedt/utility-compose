# Org-level registration
ORG_NAME=sync-mate
RUNNER_SCOPE=org

# PAT with admin:org (classic) or fine-grained org permission "Self-hosted runners: Read & write"
ACCESS_TOKEN=

# Runner behavior
LABELS=linux,self-hosted
RUNNER_WORKDIR=/tmp/runner/work
CONFIGURED_ACTIONS_RUNNER_FILES_DIR=/runner/data

# Scale via compose deploy.replicas in docker-compose.yml